[Unit]
Description=Opportunity Radar finite pipeline window
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/opportunity-radar
EnvironmentFile=/etc/opportunity-radar/api.env
EnvironmentFile=/etc/opportunity-radar/worker.env
EnvironmentFile=/etc/opportunity-radar/proxy.env
EnvironmentFile=/etc/opportunity-radar/images.env
EnvironmentFile=/etc/opportunity-radar/pipeline.env
ExecStart=/usr/local/sbin/run-opportunity-radar-window
TimeoutStartSec=3900
TimeoutStopSec=120
Restart=no
KillSignal=SIGTERM
