+++ b/apps/web/src/routes/PrimitiveSpikePage.tsx
@@ -0,0 +1,12 @@
+import { Dialog } from '@base-ui/react/dialog'
+import { Field } from '@base-ui/react/field'
+import { Menu } from '@base-ui/react/menu'
+
+export function PrimitiveSpikePage() {
+  return <main className="mx-auto grid max-w-3xl gap-6 p-6" aria-labelledby="spike-title">
+    <h1 id="spike-title">Primitives Base UI</h1>
+    <section><h2>Ações e foco</h2><Menu.Root><Menu.Trigger aria-label="Abrir ações da spike">Ações</Menu.Trigger><Menu.Portal><Menu.Positioner><Menu.Popup><Menu.Item>Marcar para revisar</Menu.Item><Menu.Item>Copiar link</Menu.Item></Menu.Popup></Menu.Positioner></Menu.Portal></Menu.Root><Dialog.Root><Dialog.Trigger>Abrir confirmação</Dialog.Trigger><Dialog.Portal><Dialog.Backdrop /><Dialog.Viewport><Dialog.Popup><Dialog.Title>Confirmar ação</Dialog.Title><Dialog.Description>Este diálogo testa Escape, contenção e retorno de foco.</Dialog.Description><Dialog.Close>Fechar</Dialog.Close></Dialog.Popup></Dialog.Viewport></Dialog.Portal></Dialog.Root></section>
+    <section><h2>Campo</h2><Field.Root><Field.Label>Busca salva</Field.Label><Field.Control placeholder="Ex.: engenharia de dados" /><Field.Description>Apenas demonstração local; não envia requisições.</Field.Description></Field.Root></section>
+    <section><h2>Tabela</h2><table><caption>Vagas de exemplo</caption><thead><tr><th scope="col">Vaga</th><th scope="col">Estado</th></tr></thead><tbody><tr><td>Analista</td><td>Revisar</td></tr></tbody></table></section>
+  </main>
+}

diff --git a/apps/web/src/routes/PrimitiveSpikePage.test.tsx b/apps/web/src/routes/PrimitiveSpikePage.test.tsx
new file mode 100644
index 0000000..0433388
--- /dev/null
+++ b/apps/web/src/routes/PrimitiveSpikePage.test.tsx
@@ -0,0 +1,18 @@
+import { act } from 'react'
+import { describe, expect, it } from 'vitest'
+import { render } from '../components/testing'
+import { PrimitiveSpikePage } from './PrimitiveSpikePage'
+
+describe('PrimitiveSpikePage Base UI', () => {
+  it('expõe label, tabela, menu e diálogo com Escape', async () => {
+    const container = render(<PrimitiveSpikePage />)
+    expect(container.querySelector('label')?.textContent).toBe('Busca salva')
+    expect(container.querySelector('caption')?.textContent).toBe('Vagas de exemplo')
+    const dialogTrigger = [...container.querySelectorAll('button')].find((button) => button.textContent === 'Abrir confirmação')!
+    act(() => dialogTrigger.click())
+    expect(document.querySelector('[role="dialog"]')).not.toBeNull()
+    act(() => document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true })))
+    await act(async () => { await new Promise((resolve) => setTimeout(resolve, 0)) })
+    expect(document.activeElement).toBe(dialogTrigger)
+  })
+})

diff --git a/tests/e2e/browser/primitive-spike.mjs b/tests/e2e/browser/primitive-spike.mjs
new file mode 100644
index 0000000..5d24c15
--- /dev/null
+++ b/tests/e2e/browser/primitive-spike.mjs
@@ -0,0 +1,38 @@
+import { chromium } from '@playwright/test'
+
+const browser = await chromium.launch()
+const page = await browser.newPage({ viewport: { width: 1280, height: 800 } })
+const allowedOrigin = 'http://127.0.0.1:4173'
+const blockedRequests = []
+await page.route('**/*', async (route) => {
+  const requestUrl = new URL(route.request().url())
+  if (requestUrl.origin !== allowedOrigin || requestUrl.pathname.startsWith('/api')) {
+    blockedRequests.push(requestUrl.href)
+    await route.abort()
+    return
+  }
+  await route.continue()
+})
+await page.goto('http://127.0.0.1:4173/__f54-primitives', { waitUntil: 'networkidle' })
+await page.getByRole('button', { name: 'Abrir confirmação' }).focus()
+await page.keyboard.press('Enter')
+await page.getByRole('dialog').waitFor()
+await page.keyboard.press('Tab')
+const tabFocusInDialog = await page.evaluate(() => document.activeElement?.closest('[role="dialog"]') !== null)
+await page.keyboard.press('Shift+Tab')
+const shiftTabFocusInDialog = await page.evaluate(() => document.activeElement?.closest('[role="dialog"]') !== null)
+await page.keyboard.press('Escape')
+await page.getByRole('dialog').waitFor({ state: 'detached' })
+const returnedFocus = await page.evaluate(() => document.activeElement?.textContent)
+await page.getByRole('button', { name: 'Abrir ações da spike' }).focus()
+await page.keyboard.press('ArrowDown')
+await page.getByRole('menu').waitFor()
+await page.keyboard.press('Escape')
+await page.getByRole('menu').waitFor({ state: 'detached' })
+const menuFocusReturned = await page.evaluate(() => document.activeElement?.getAttribute('aria-label'))
+const labels = await page.locator('label').allTextContents()
+if (blockedRequests.length > 0 || !tabFocusInDialog || !shiftTabFocusInDialog || returnedFocus !== 'Abrir confirmação' || menuFocusReturned !== 'Abrir ações da spike') {
+  throw new Error(JSON.stringify({ blockedRequests, tabFocusInDialog, shiftTabFocusInDialog, returnedFocus, menuFocusReturned }))
+}
+console.log(JSON.stringify({ route: await page.title(), returnedFocus, menuFocusReturned, tabFocusInDialog, shiftTabFocusInDialog, labels, blockedRequests }))
+await browser.close()
