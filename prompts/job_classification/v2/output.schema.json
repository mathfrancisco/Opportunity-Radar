{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role_family": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": [
            "software_engineering", "data", "infrastructure", "security", "qa",
            "product", "design", "sales", "marketing", "operations", "people",
            "finance", "legal", "support", "other", null
          ]
        },
        "evidence": {"type": ["string", "null"]}
      },
      "required": ["value", "evidence"]
    },
    "seniority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": [
            "intern", "junior", "mid", "senior", "staff", "lead", "manager",
            "director", null
          ]
        },
        "evidence": {"type": ["string", "null"]}
      },
      "required": ["value", "evidence"]
    },
    "work_mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": ["remote", "hybrid", "onsite", null]
        },
        "evidence": {"type": ["string", "null"]}
      },
      "required": ["value", "evidence"]
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "null"], "pattern": "^[A-Za-z]{2}$"},
        "evidence": {"type": ["string", "null"]}
      },
      "required": ["value", "evidence"]
    },
    "work_authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": [
            "REQUIRED_LOCAL_AUTHORIZATION", "SPONSORSHIP_AVAILABLE",
            "SPONSORSHIP_NOT_AVAILABLE", null
          ]
        },
        "evidence": {"type": ["string", "null"]}
      },
      "required": ["value", "evidence"]
    }
  },
  "required": ["role_family", "seniority", "work_mode", "country", "work_authorization"]
}
