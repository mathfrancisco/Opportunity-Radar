# PostgreSQL (used only inside the Docker network by default)
POSTGRES_DB=opportunity_radar
POSTGRES_USER=opportunity_radar
POSTGRES_PASSWORD=change-me-for-local-use

# Application runtime
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://opportunity_radar:change-me-for-local-use@postgres:5432/opportunity_radar
FRONTEND_ORIGIN=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
COLLECTION_TIMEZONE=America/Sao_Paulo
WORKER_COLLECT_ENABLED=true
WORKER_NORMALIZE_ENABLED=true
WORKER_MATCH_ENABLED=true
WORKER_ANALYZE_ENABLED=true
WORKER_EVALUATE_BATCH_SIZE=500
WORKER_ANALYZE_BATCH_SIZE=10
WORKER_ANALYZE_VERDICTS=HIGH_PRIORITY,RECOMMENDED
# R55-B2: sources with no cron ("manual"/empty) are collected by the finite window once their
# last success is older than this many hours; 0 turns it off.
MANUAL_SOURCE_MIN_INTERVAL_HOURS=1
# R55-C1: windows per day that share the AI request ceiling (soft limit minus interactive reserve).
PIPELINE_ANALYZE_WINDOWS_PER_DAY=24
# Share of the window's remaining time the collect / normalize stages may use, so evaluation
# and analysis always get theirs (a spent share is a partial completion, exit stays 0).
PIPELINE_COLLECT_BUDGET_FRACTION=0.4
PIPELINE_NORMALIZE_BUDGET_FRACTION=0.3
WORKER_ANALYZE_AGING_SAMPLE_RATIO=0.10
WORKER_ANALYZE_DAILY_CAP_FRACTION=0.8
WORKER_SUGGEST_ENABLED=false
WORKER_SUGGEST_BATCH_SIZE=20
# Description-based classification rules to switch on, comma separated, named as
# scripts/measure_content_classification.py prints them. Empty keeps them all off. Enable a rule
# only after it reaches 90% precision on the gold set (F50-02).
CONTENT_CLASSIFICATION_ENABLED_RULES=
ANALYSIS_RETRY_COOLDOWN_SECONDS=3600
ANALYSIS_RETRY_ATTEMPT_WINDOW_SECONDS=86400
ANALYSIS_RETRY_MAX_ATTEMPTS=3
ANALYSIS_CLAIM_LEASE_SECONDS=900
COLLECTION_BACKOFF_BASE_SECONDS=300
COLLECTION_BACKOFF_CEILING_SECONDS=86400
# Below this share of target-area items (last 3 complete runs) a source stops persisting new off-target items; 0 disables.
COLLECTION_TARGET_AREA_FLOOR=0
# R55-B5: collection is general; true = do not store new vacancies clearly outside the profile's areas or countries.
COLLECTION_PREFILTER_ENABLED=false
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io
# Leave the webhook empty to keep incidents in the database and in the doctor only.
SOURCE_ALERT_WEBHOOK_URL=
SOURCE_ALERT_FAILURE_THRESHOLD=3
SOURCE_ALERT_TIMEOUT_SECONDS=5
WORKER_RETENTION_ENABLED=true
PAYLOAD_RETENTION_DAYS=2
PAYLOAD_RETENTION_BATCH_SIZE=500
PAYLOAD_RETENTION_INTERVAL_SECONDS=21600
# Deletes superseded match assessments. Keep off until `scripts/prune_assessments.py` (dry run) was read.
WORKER_ASSESSMENT_RETENTION_ENABLED=false
ASSESSMENT_RETENTION_DAYS=1
ASSESSMENT_RETENTION_BATCH_SIZE=500
OPPORTUNITY_RETENTION_DAYS=7
OPPORTUNITY_RETENTION_BATCH_SIZE=500
# R55-B5: stored off-target opportunities (area/country of the profile) go after this many days; 0 disables.
OPPORTUNITY_OFF_TARGET_RETENTION_DAYS=0
# Owner OK after reading the dry-run counts in the pipeline log; false = count only.
OPPORTUNITY_RETENTION_APPLY=false
RETENTION_STAGE_BUDGET_SECONDS=300
DATABASE_SIZE_LIMIT_BYTES=1000000000
DATABASE_SIZE_ALERT_RATIO=0.7
DOCTOR_JOB_GRACE_SECONDS=120
# Postgres cancels an API query longer than this many ms (the API answers 503); 0 disables. Not applied to the worker.
API_STATEMENT_TIMEOUT_MS=15000

# Tavily search/extract (docs/41-spec-tavily.md). Leave the key empty to keep the
# source blocked by configuration; the radar keeps working without it.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_FORMAT=markdown
TAVILY_CREDIT_BUDGET_PER_RUN=100
TAVILY_EXTRACT_CACHE_TTL_SECONDS=2592000
EXTRACTION_SKIP_SOURCE_TYPES=workday,inhire
TAVILY_EXTRACT_HOST_FAILURE_THRESHOLD=5
HOST_REQUEST_CEILINGS=workday=500,hacker_news=500,inhire=1200

# Reserved for the backup flow planned for a later phase.
BACKUP_RETENTION_DAYS=14

# Cloud AI is opt-in and runs with any one provider key (Groq or a reserve below).
# Set real keys only in the untracked .env file.
AI_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ALT_MODEL=qwen/qwen3.8-27b
# Reserve providers: each is off without a key. With a key, its models join the end of every
# task's chain (or form the whole chain when GROQ_API_KEY is empty). Free limits, privacy and
# sources: docs/research/2026-10-20-llm-gratuitos.md
# Daily caps are counted per model, but OpenRouter's 50/day and Workers AI's 10 k neurons/day are
# per account: each extra model in a *_MODELS list multiplies the cap the vendor really grants.
# Token Harbor: soft limit here: the global AI_* limits (this project's default); vendor: 60 RPM,
# 1,8 k/hora, janela móvel de 7 dias, "pode reter prompts"; free models must be switched on.
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODELS=deepseek-v4.1-flash:free,mimo-v2.6-flash:free
# Cerebras: soft limit here: 900 req and 950 k tokens/day per model (this project's default);
# vendor: 5 RPM, 90 k TPM, 1 M tokens/hora e /dia por modelo, cartão verificado; privacy: "não declarado".
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODELS=gpt-oss-120b,qwen-3.8-27b
# OpenCode Zen: soft limit here: 300 req and 1,5 M tokens/day per model (this project's default);
# vendor: grátis "por tempo limitado", limites não publicados; zero retenção e sem treino nesses três modelos.
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/inference/openai/v1
ZEN_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free,minimax-m3.1-flash-free
# Google AI Studio (Gemma): soft limit here: 500 req and 1 M tokens/day per model (this project's default);
# vendor: não publicado por modelo (um blog cita 3 k/dia); grátis pode ser usado para melhorar produtos fora de EEA/UK/CH.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODELS=gemma-4-31b-it
# OpenRouter: soft limit here: 45 req and 300 k tokens/day per model (this project's default);
# vendor: 20 RPM, 50/dia por conta (1 k/dia após US$ 10 em créditos); provedores grátis podem registrar prompts.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# No default model: the free catalogue changes often. Pick a current `:free` id that
# passes scripts/probe_ai_providers.py; empty keeps OpenRouter out of the chain.
OPENROUTER_MODELS=
# Mistral (La Plateforme): soft limit here: 500 req and 1 M tokens/day per model (this project's default);
# vendor: limite não publicado; grátis exige aceitar treino.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODELS=mistral-small-latest
# NVIDIA NIM: soft limit here: 1000 req and 1 M tokens/day per model (this project's default);
# vendor: 40 RPM; "trial use only - do not submit personal or confidential data".
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODELS=openai/gpt-oss-20b
# Cloudflare Workers AI: soft limit here: 40 req and 250 k tokens/day per model (this project's default);
# vendor: 10 k neurons/dia por conta, acima disso cobra US$ 0,011 / 1 k neurons; privacy: "não declarado".
# Needs the account id: without CLOUDFLARE_ACCOUNT_ID the provider stays out of the chains.
WORKERSAI_API_KEY=
WORKERSAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1
WORKERSAI_MODELS=@cf/openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
# Order in which reserve providers follow Groq in every chain; unknown names are ignored.
AI_RESERVE_ORDER=cerebras,zen,nim,tokenharbor,gemini,mistral,openrouter,workersai
# Optional per-provider soft-limit overrides, JSON, e.g.
# AI_PROVIDER_LIMITS={"zen": {"day_requests": 100}}
# Keys: minute_requests, minute_tokens, day_requests, day_tokens. {} keeps the defaults.
AI_PROVIDER_LIMITS={}
AI_TIMEOUT_SECONDS=25
AI_CONNECT_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=2
AI_FALLBACK_ENABLED=true
AI_REASONING_EFFORT=low
# Per-task overrides (card F20-22); unset means "use AI_REASONING_EFFORT" for that task.
AI_REASONING_EFFORT_JOB_MATCH=
AI_REASONING_EFFORT_JOB_CLASSIFICATION=
AI_REASONING_EFFORT_JOB_EXTRACTION=
# v1 is the default; v3 sends a smaller payload with capped lists and a lower output ceiling.
AI_ANALYSIS_PROMPT=v1
AI_DAILY_REQUESTS_SOFT_LIMIT=850
# What the Groq free tier grants one model per UTC day; the panel shows it (R55-C6).
AI_PROVIDER_DAILY_REQUESTS_LIMIT=1000
AI_INTERACTIVE_RESERVE_REQUESTS=100
AI_DAILY_TOKENS_SOFT_LIMIT=170000
AI_MINUTE_TOKENS_SOFT_LIMIT=7000
AI_MINUTE_REQUESTS_SOFT_LIMIT=25
AI_BREAKER_FAILURES=5
AI_BREAKER_COOLDOWN_SECONDS=120
AI_CALL_RECORD_RETENTION_DAYS=7
